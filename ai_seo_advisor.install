<?php
/**
 * @file
 * Install, update and uninstall functions for the AI SEO Advisor module.
 */

/**
 * Implements hook_schema().
 */
function ai_seo_advisor_schema() {
  $schema = array();

  $schema['ai_seo_report'] = array(
    'description' => 'Stores SEO analysis reports for content.',
    'fields' => array(
      'report_id' => array(
        'type' => 'serial',
        'not null' => TRUE,
        'description' => 'Primary Key: Unique report ID.',
      ),
      'entity_type' => array(
        'type' => 'varchar',
        'length' => 128,
        'not null' => TRUE,
        'default' => 'node',
        'description' => 'The entity type (e.g., node).',
      ),
      'entity_id' => array(
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
        'description' => 'The entity ID.',
      ),
      'report_type' => array(
        'type' => 'varchar',
        'length' => 64,
        'not null' => TRUE,
        'default' => 'seo_analysis',
        'description' => 'The report type machine name.',
      ),
      'title' => array(
        'type' => 'varchar',
        'length' => 255,
        'not null' => TRUE,
        'default' => '',
        'description' => 'The content title at time of analysis.',
      ),
      'focus_keyword' => array(
        'type' => 'varchar',
        'length' => 255,
        'not null' => FALSE,
        'description' => 'The focus keyword used for analysis.',
      ),
      'score' => array(
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
        'description' => 'The overall SEO score (0-100).',
      ),
      'status' => array(
        'type' => 'varchar',
        'length' => 16,
        'not null' => TRUE,
        'default' => 'RED',
        'description' => 'The status: GREEN, AMBER, or RED.',
      ),
      'report_data' => array(
        'type' => 'blob',
        'size' => 'big',
        'not null' => FALSE,
        'serialize' => TRUE,
        'description' => 'Serialized report data (checks, recommendations, AI suggestions, etc.).',
      ),
      'html_snapshot' => array(
        'type' => 'text',
        'size' => 'big',
        'not null' => FALSE,
        'description' => 'HTML snapshot used for analysis.',
      ),
      'uid' => array(
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
        'description' => 'The user ID who generated the report.',
      ),
      'created' => array(
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
        'description' => 'The Unix timestamp when the report was created.',
      ),
      'changed' => array(
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
        'description' => 'The Unix timestamp when the report was last changed.',
      ),
    ),
    'primary key' => array('report_id'),
    'indexes' => array(
      'entity_type' => array('entity_type'),
      'entity_id' => array('entity_id'),
      'report_type' => array('report_type'),
      'uid' => array('uid'),
      'created' => array('created'),
      'entity' => array('entity_type', 'entity_id'),
    ),
  );

  return $schema;
}

/**
 * Implements hook_install().
 */
function ai_seo_advisor_install() {
  if (!module_load_install('ai_upgrade')) { return []; }
  ai_upgrade_module_install('ai_seo_advisor');

  // Report types are now loaded from individual config files.
  // They are automatically imported from the config/ directory.
}

/**
 * Implements hook_requirements().
 */
function ai_seo_advisor_requirements($phase) {
  $requirements = [];

  // Verify entity_plus is enabled at runtime so existing sites upgrading
  // cannot reach AiSEOReportController (which extends EntityPlusController)
  // without the dependency present.
  if ($phase === 'runtime') {
    if (!module_exists('entity_plus')) {
      $requirements['ai_seo_advisor_entity_plus'] = [
        'title' => t('AI SEO Advisor'),
        'value' => t('entity_plus module is missing'),
        'description' => t('The AI SEO Advisor module requires the entity_plus module to be enabled. Enable entity_plus before using this module.'),
        'severity' => REQUIREMENT_ERROR,
      ];
    }
  }

  if (!module_load_install('ai_upgrade')) {
    return $requirements;
  }
  return $requirements + ai_upgrade_module_requirements($phase, 'ai_seo_advisor');
}

/**
 * Rename openai_seo_report table to ai_seo_report.
 */
function ai_seo_advisor_update_1002() {
  if (db_table_exists('openai_seo_report') && !db_table_exists('ai_seo_report')) {
    db_rename_table('openai_seo_report', 'ai_seo_report');
  }
  elseif (db_table_exists('openai_seo_report')) {
    db_drop_table('openai_seo_report');
  }
  return t('Renamed openai_seo_report to ai_seo_report.');
}

/**
 * Formerly removed columns from ai_seo_report; now a no-op.
 *
 * hook_schema() and the AiSEOReport entity still declare and write
 * focus_keyword, score, and status, so dropping them broke every subsequent
 * report save on sites that ran this update. Update 1003 restores the
 * columns where they are missing.
 */
function ai_seo_advisor_update_1001() {
  return t('No schema changes (deprecated update).');
}

/**
 * Restore columns dropped by the old update 1001 where missing.
 */
function ai_seo_advisor_update_1003() {
  // Field specs are frozen at this update's version. Do not read from
  // ai_seo_advisor_schema() — later schema changes must not alter this
  // historical migration.
  $fields = [
    'focus_keyword' => [
      'type' => 'varchar',
      'length' => 255,
      'not null' => FALSE,
      'description' => 'The focus keyword used for analysis.',
    ],
    'score' => [
      'type' => 'int',
      'not null' => TRUE,
      'default' => 0,
      'description' => 'The overall SEO score (0-100).',
    ],
    'status' => [
      'type' => 'varchar',
      'length' => 16,
      'not null' => TRUE,
      'default' => 'RED',
      'description' => 'The status: GREEN, AMBER, or RED.',
    ],
  ];
  $restored = [];
  if (db_table_exists('ai_seo_report')) {
    foreach ($fields as $field => $spec) {
      if (!db_field_exists('ai_seo_report', $field)) {
        db_add_field('ai_seo_report', $field, $spec);
        $restored[] = $field;
      }
    }
  }
  return $restored
    ? t('Restored ai_seo_report column(s): @cols.', ['@cols' => implode(', ', $restored)])
    : t('ai_seo_report columns already match the schema.');
}

/**
 * Migrate from combined report_types config to individual config files.
 */
function ai_seo_advisor_update_1000() {
  // Check if old combined config exists.
  $old_config = config('ai_seo_advisor.report_types');
  $types = $old_config->get();
  
  if (!empty($types) && is_array($types)) {
    // Migrate each report type to its own config file.
    foreach ($types as $name => $type_data) {
      if (is_array($type_data) && !empty($type_data['name'])) {
        $new_config = config('ai_seo_advisor.report_type.' . $name);
        $new_config->set('_config_name', 'ai_seo_advisor.report_type.' . $name);
        $new_config->set('name', $type_data['name']);
        $new_config->set('label', !empty($type_data['label']) ? $type_data['label'] : $name);
        $new_config->set('description', !empty($type_data['description']) ? $type_data['description'] : '');
        $new_config->set('prompt', !empty($type_data['prompt']) ? $type_data['prompt'] : '');
        $new_config->set('status', !empty($type_data['status']) ? 1 : 0);
        $new_config->set('weight', !empty($type_data['weight']) ? (int)$type_data['weight'] : 0);
        $new_config->save();
      }
    }
    
    // Delete the old combined config.
    $old_config->delete();
    
    return t('Migrated report types from combined config to individual config files.');
  }
  
  return t('No migration needed - already using individual config files.');
}

/**
 * Implements hook_uninstall().
 */
function ai_seo_advisor_uninstall() {
  // Remove all report type configurations (individual files).
  $config_names = config_get_names_with_prefix('ai_seo_advisor.report_type.');
  foreach ($config_names as $config_name) {
    config($config_name)->delete();
  }
  
  // Remove settings.
  config('ai_seo_advisor.settings')->delete();
  
  // Remove old combined config if it exists.
  config('ai_seo_advisor.report_types')->delete();
}
