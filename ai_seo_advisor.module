/**
 * Implements hook_entity_info().
 */
function ai_seo_advisor_entity_info() {
  if (!module_exists('entity_plus')) {
    return [];
  }
  $info = [];

  $info['ai_seo_report'] = [
    'label' => t('SEO Report'),
    'plural label' => t('SEO Reports'),
    'entity class' => 'AiSEOReport',
    'controller class' => 'AiSEOReportController',
    'base table' => 'ai_seo_report',
    'fieldable' => FALSE,
    'entity keys' => [
      'id' => 'report_id',
    ],
    'bundles' => [],
    'view modes' => [
      'full' => [
        'label' => t('Full report'),
        'custom settings' => FALSE,
      ],
    ],
    'module' => 'ai_seo_advisor',
    'access callback' => 'ai_seo_advisor_report_access',
  ];

  return $info;
}

/**
 * Access callback for SEO reports.
 */
function ai_seo_advisor_report_access($op, $report = NULL, $account = NULL) {
  if (empty($account)) {
    global $user;
    $account = $user;
  }

  if (user_access('administer ai seo settings', $account)) {
    return TRUE;
  }

  if ($op == 'view' && user_access('view ai seo reports', $account)) {
    return TRUE;
  }

  if ($op == 'create' && user_access('analyze content seo with ai', $account)) {
    return TRUE;
  }

  if ($op == 'update' || $op == 'delete') {
    if (user_access('administer ai seo settings', $account)) {
      return TRUE;
    }
  }

  return FALSE;
}

