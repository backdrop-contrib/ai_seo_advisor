<?php

/**
 * @file
 * AI SEO Advisor module.
 *
 * Provides a SEO analysis panel on node edit forms. Performs
 * rules-only checks locally and can optionally request AI suggestions when
 * an AI provider is configured. Never modifies contrib.
 */

/**
 * Implements hook_ai_tools().
 */
function ai_seo_advisor_ai_tools() {
  if (!module_exists('ai_tools')) {
    return [];
  }
  module_load_include('inc', 'ai_seo_advisor', 'includes/seo.tools');
  return ai_seo_advisor_tools_definitions();
}

