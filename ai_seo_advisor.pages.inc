<?php
/**
 * @file
 * Page callbacks for AI SEO Advisor module.
 */

/**
 * Page callback: Display list of SEO reports for a node.
 */
function ai_seo_advisor_reports_page($node) {
  backdrop_set_title(t('SEO Reports for @title', ['@title' => check_plain($node->title)]), PASS_THROUGH);

  $output = [];

  // Add the analysis form at the top if user can analyze.
  if (user_access('analyze content seo with ai')) {
    $output['analyze_form'] = backdrop_get_form('ai_seo_advisor_analyze_form', $node);
  }

  // Query for reports.
  $query = db_select('ai_seo_report', 'r')
    ->fields('r')
    ->condition('entity_type', 'node')
    ->condition('entity_id', $node->nid)
    ->orderBy('created', 'DESC');

  $results = $query->execute();

  $reports = [];
  foreach ($results as $row) {
    $reports[] = entity_load('ai_seo_report', $row->report_id);
  }

  if (empty($reports)) {
    $output['empty'] = [
      '#type' => 'markup',
      '#markup' => '<p>' . t('No SEO reports have been generated for this content yet.') . '</p>',
    ];

    return $output;
  }

  // Build table of reports.
  $output['reports_header'] = [
    '#type' => 'markup',
    '#markup' => '<h2>' . t('Report History') . '</h2>',
  ];

  $header = [
    t('Date'),
    t('Report Type'),
    t('Generated By'),
    t('Operations'),
  ];

  $rows = [];
  foreach ($reports as $report) {
    $user = user_load($report->uid);
    $operations = [];
    $operations[] = l(t('View'), 'node/' . $node->nid . '/ai-seo/' . $report->report_id . '/view');
    if (ai_seo_advisor_report_access('delete', $report)) {
      $operations[] = l(t('Delete'), 'node/' . $node->nid . '/ai-seo/' . $report->report_id . '/delete');
    }

    // Get report type label.
    $report_types = ai_seo_advisor_get_report_types();
    $report_type_label = !empty($report_types[$report->report_type]['label'])
      ? $report_types[$report->report_type]['label']
      : $report->report_type;

    $rows[] = [
      format_date($report->created, 'short'),
      check_plain($report_type_label),
      theme('username', ['account' => $user]),
      implode(' | ', $operations),
    ];
  }

  $output['table'] = [
    '#theme' => 'table',
    '#header' => $header,
    '#rows' => $rows,
  ];

  return $output;
}

/**
 * Page callback: Display a single SEO report.
 */
function ai_seo_advisor_report_view($node, $report) {
  ai_seo_advisor_include_reports();
  
  if ($report->entity_id != $node->nid) {
    backdrop_access_denied();
    backdrop_exit();
  }

  backdrop_set_title(t('SEO Report for @title', ['@title' => check_plain($report->title)]), PASS_THROUGH);

  $output = [];

  // Breadcrumb back to reports list.
  $breadcrumb = [
    l(t('Home'), '<front>'),
    l($node->title, 'node/' . $node->nid),
    l(t('SEO Reports'), 'node/' . $node->nid . '/ai-seo'),
  ];
  backdrop_set_breadcrumb($breadcrumb);

  // Report metadata.
  $output['metadata'] = [
    '#type' => 'container',
    '#attributes' => ['class' => ['ai-seo-report-metadata']],
  ];

  $output['metadata']['date'] = [
    '#type' => 'item',
    '#title' => t('Generated'),
    '#markup' => format_date($report->created, 'long'),
  ];

  $user = user_load($report->uid);
  $output['metadata']['user'] = [
    '#type' => 'item',
    '#title' => t('By'),
    '#markup' => theme('username', ['account' => $user]),
  ];

  // Render the report.
  $output['report'] = ai_seo_advisor_render_results($report->report_data);

  return $output;
}

/**
 * Form constructor for the SEO analysis form.
 */
function ai_seo_advisor_analyze_form($form, &$form_state, $node) {
  $form['#node'] = $node;

  $form['header'] = [
    '#type' => 'markup',
    '#markup' => '<h2>' . t('Generate New SEO Report') . '</h2>',
  ];

  // Report type selector.
  $report_types = ai_seo_advisor_get_report_types();
  $report_type_options = [];
  foreach ($report_types as $machine_name => $type) {
    if (!empty($type['status'])) {
      $label = !empty($type['label']) ? $type['label'] : $machine_name;
      $report_type_options[$machine_name] = check_plain($label);
    }
  }

  if (empty($report_type_options)) {
    $report_type_options['full'] = t('Full SEO Analysis (default)');
  }

  $form['report_type'] = [
    '#type' => 'select',
    '#title' => t('Report type'),
    '#options' => $report_type_options,
    '#default_value' => 'full',
  ];

  $wrapper_id = 'ai-seo-advisor-results';

  $form['analyze'] = [
    '#type' => 'submit',
    '#value' => t('Analyze SEO'),
    '#ajax' => [
      'callback' => 'ai_seo_advisor_analyze_form_ajax',
      'wrapper' => $wrapper_id,
      'method' => 'replace',
      'effect' => 'fade',
      'progress' => ['type' => 'throbber', 'message' => t('Analyzing…')],
    ],
  ];

  $form['results'] = [
    '#type' => 'container',
    '#attributes' => ['id' => $wrapper_id],
  ];

  // If we have results from a previous submission, display them.
  if (isset($form_state['seo_result'])) {
    ai_seo_advisor_include_reports();
    $form['results'] = ai_seo_advisor_render_results($form_state['seo_result']);
    $form['results']['#prefix'] = '<div id="' . check_plain($wrapper_id) . '">';
    $form['results']['#suffix'] = '</div>';
  }

  return $form;
}

/**
 * AJAX callback for the SEO analysis form.
 */
function ai_seo_advisor_analyze_form_ajax($form, &$form_state) {
  return $form['results'];
}

/**
 * Form submission handler for ai_seo_advisor_analyze_form().
 */
function ai_seo_advisor_analyze_form_submit($form, &$form_state) {
  ai_seo_advisor_include_reports();
  $node = $form['#node'];
  $report_type = !empty($form_state['values']['report_type']) ? $form_state['values']['report_type'] : 'full';

  // Load the node to get current content.
  $node = node_load($node->nid);

  // Get settings.
  $opts = config_get('ai_seo_advisor.settings', 'options');
  $opts = is_array($opts) ? $opts : [];
  $ai_model = !empty($opts['ai_model']) ? $opts['ai_model'] : (config_get('ai.settings', 'default_text_model'));
  // Reasoning models (o1, o3, gpt-5-nano, etc.) burn tokens on internal thinking
  // before producing output, so they need a much larger budget than standard models.
  $model_bare = (strpos($ai_model, '/') !== FALSE) ? explode('/', $ai_model, 2)[1] : $ai_model;
  $is_reasoning_model = (bool) preg_match('/^(o1|o3|o4|gpt-5)/i', $model_bare);
  $ai_max_tokens = $is_reasoning_model ? 16000 : 3000;

  // Build preview HTML from the saved node.
  $html = '';
  try {
    $build = node_view($node, 'full');
    if (is_array($build) && !empty($build)) {
      $rendered = trim((string) backdrop_render($build));
      if ($rendered !== '') {
        // Prepend the H1 page title (which theme would normally add).
        $title_safe = check_plain($node->title);
        $html = '<h1>' . $title_safe . '</h1>' . "\n" . $rendered;
      }
    }
  }
  catch (\Exception $e) {
    watchdog('ai_seo_advisor', 'Failed to render node: @m', ['@m' => $e->getMessage()], WATCHDOG_WARNING);
  }

  // Strip the preview warning message from HTML.
  if ($html !== '') {
    $html = preg_replace(
      '#<div\s+class="messages\s+warning"[^>]*>.*?</div>\s*#is',
      '',
      $html
    );
  }

  $used_preview = ($html !== '');

  // Fallback plain text collection.
  $raw_text = '';
  if (!$used_preview) {
    // Extract text from node fields.
    $wrapper = entity_metadata_wrapper('node', $node);
    if (isset($wrapper->body) && $wrapper->body->value()) {
      $body = $wrapper->body->value();
      $raw_text = strip_tags($body['value']);
    }
  }

  // Title.
  $title = $node->title;

  // Prefer preview HTML as analysis source when available.
  $text = $used_preview ? $html : $raw_text;

  // Extract meta description from Metatag if present.
  $meta_description = '';
  if (!empty($node->metatags)) {
    $metatags = $node->metatags;
    $langcode = !empty($node->language) ? $node->language : LANGUAGE_NONE;
    if (!empty($metatags[$langcode]['description']['value'])) {
      $meta_description = $metatags[$langcode]['description']['value'];
    }
  }

  // Run rules analysis (no focus keyword).
  $result = ai_seo_advisor_analyze($title, $text, $meta_description, '');
  $result['source'] = isset($result['source']) && is_array($result['source']) ? $result['source'] : [];
  $result['source'] = array_merge($result['source'], [
    'used_preview' => (bool) $used_preview,
    'view_mode' => 'full',
  ]);

  // Generate AI report.
  $enable_ai = TRUE;
  if ($enable_ai) {
    $ai_source_html = $used_preview ? $text : $raw_text;
    $ai = ai_seo_advisor_generate_ai_suggestions($title, $ai_source_html, $raw_text, $meta_description, '', $ai_model, $ai_max_tokens, $report_type);
    if (is_array($ai)) {
      $result['ai'] = $ai;
    }
  }

  // Save report to database.
  try {
    $report = entity_create('ai_seo_report', [
      'entity_type' => 'node',
      'entity_id' => $node->nid,
      'report_type' => $report_type,
      'title' => $title,
      'report_data' => $result,
      'html_snapshot' => $html,
    ]);
    $report->save();

    backdrop_set_message(t('SEO report saved successfully. Report ID: @id', ['@id' => $report->report_id]));
  }
  catch (\Exception $e) {
    backdrop_set_message(t('Error saving report: @msg', ['@msg' => $e->getMessage()]), 'error');
    watchdog('ai_seo_advisor', 'Failed to save report: @msg', ['@msg' => $e->getMessage()], WATCHDOG_ERROR);
  }

  // Store result in form_state for display.
  $form_state['seo_result'] = $result;
  $form_state['rebuild'] = TRUE;
}

/**
 * Form to confirm deletion of an SEO report.
 */
function ai_seo_advisor_report_delete_form($form, &$form_state, $node, $report) {
  if ($report->entity_id != $node->nid) {
    backdrop_access_denied();
    backdrop_exit();
  }

  $form['report_id'] = [
    '#type' => 'value',
    '#value' => $report->report_id,
  ];

  $form['node'] = [
    '#type' => 'value',
    '#value' => $node,
  ];

  return confirm_form(
    $form,
    t('Are you sure you want to delete this SEO report?'),
    'node/' . $node->nid . '/ai-seo',
    t('Created on @date. This action cannot be undone.', ['@date' => format_date($report->created)]),
    t('Delete'),
    t('Cancel')
  );
}

/**
 * Submit handler for delete SEO report form.
 */
function ai_seo_advisor_report_delete_form_submit($form, &$form_state) {
  $report_id = $form_state['values']['report_id'];
  $node = $form_state['values']['node'];

  $report = entity_load('ai_seo_report', $report_id);
  if ($report) {
    $report->delete();
    backdrop_set_message(t('SEO report deleted.'));
  }

  $form_state['redirect'] = 'node/' . $node->nid . '/ai-seo';
}
