<?php
/**
 * @file
 * Entity class and controller for OpenAI SEO Report.
 */

/**
 * The class used for OpenAI SEO Report entities.
 */
class OpenAISEOReport extends Entity {

  /**
   * The report ID.
   *
   * @var int
   */
  public $report_id;

  /**
   * The entity type.
   *
   * @var string
   */
  public $entity_type = 'node';

  /**
   * The entity ID.
   *
   * @var int
   */
  public $entity_id;

  /**
   * The report type.
   *
   * @var string
   */
  public $report_type = 'seo_analysis';

  /**
   * The content title.
   *
   * @var string
   */
  public $title = '';

  /**
   * The focus keyword.
   *
   * @var string
   */
  public $focus_keyword;

  /**
   * The SEO score.
   *
   * @var int
   */
  public $score = 0;

  /**
   * The status (GREEN, AMBER, RED).
   *
   * @var string
   */
  public $status = 'RED';

  /**
   * The report data.
   *
   * @var array
   */
  public $report_data = array();

  /**
   * The HTML snapshot.
   *
   * @var string
   */
  public $html_snapshot;

  /**
   * The user ID.
   *
   * @var int
   */
  public $uid;

  /**
   * The created timestamp.
   *
   * @var int
   */
  public $created;

  /**
   * The changed timestamp.
   *
   * @var int
   */
  public $changed;

  /**
   * Constructs a new OpenAISEOReport object.
   */
  public function __construct(array $values = array()) {
    parent::__construct($values, 'openai_seo_report');
  }

  /**
   * Implements EntityInterface::id().
   */
  public function id() {
    return isset($this->report_id) ? $this->report_id : NULL;
  }

  /**
   * Implements EntityInterface::entityType().
   */
  public function entityType() {
    return 'openai_seo_report';
  }

  /**
   * Implements EntityInterface::uri().
   */
  public function uri() {
    return array(
      'path' => 'node/' . $this->entity_id . '/seo/' . $this->report_id,
    );
  }

  /**
   * Overrides Entity::save().
   */
  public function save() {
    global $user;

    if (empty($this->uid)) {
      $this->uid = $user->uid;
    }

    $this->changed = REQUEST_TIME;

    if (empty($this->created)) {
      $this->created = REQUEST_TIME;
    }

    return parent::save();
  }

  /**
   * Returns the report URL (deprecated, use uri()).
   */
  public function url() {
    return 'node/' . $this->entity_id . '/seo/' . $this->report_id;
  }

  /**
   * Returns the report label.
   */
  public function label() {
    return t('SEO Report #@id for @title', array(
      '@id' => $this->report_id,
      '@title' => $this->title,
    ));
  }
}

/**
 * Controller class for OpenAI SEO Report entities.
 */
class OpenAISEOReportController extends EntityPlusController {

  /**
   * Overrides EntityPlusController::create().
   */
  public function create(array $values = array()) {
    $values += array(
      'report_id' => NULL,
      'entity_type' => 'node',
      'entity_id' => 0,
      'report_type' => 'seo_analysis',
      'title' => '',
      'focus_keyword' => NULL,
      'score' => 0,
      'status' => 'RED',
      'report_data' => array(),
      'html_snapshot' => NULL,
      'uid' => 0,
      'created' => REQUEST_TIME,
      'changed' => REQUEST_TIME,
    );

    return parent::create($values);
  }

  /**
   * Overrides EntityPlusController::buildContent().
   */
  public function buildContent(EntityInterface $entity, $view_mode = 'full', $langcode = NULL, $content = array()) {
    $build = parent::buildContent($entity, $view_mode, $langcode, $content);

    // Render the report.
    $build['report'] = openai_seo_advisor_render_results($entity->report_data);
    $build['report']['#weight'] = 0;

    // Add metadata.
    $build['metadata'] = array(
      '#type' => 'container',
      '#attributes' => array('class' => array('openai-seo-report-metadata')),
      '#weight' => -10,
    );

    $build['metadata']['created'] = array(
      '#type' => 'item',
      '#title' => t('Created'),
      '#markup' => format_date($entity->created, 'medium'),
    );

    $build['metadata']['user'] = array(
      '#type' => 'item',
      '#title' => t('Generated by'),
      '#markup' => theme('username', array('account' => user_load($entity->uid))),
    );

    if (!empty($entity->focus_keyword)) {
      $build['metadata']['keyword'] = array(
        '#type' => 'item',
        '#title' => t('Focus keyword'),
        '#markup' => check_plain($entity->focus_keyword),
      );
    }

    return $build;
  }
}
