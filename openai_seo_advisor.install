<?php

/**
 * @file
 * Install and update hooks for OpenAI SEO Advisor.
 */

/**
 * Implements hook_install().
 */
function openai_seo_advisor_install() {
  $config = config('openai_seo_advisor.settings');

  // Initialize enabled_bundles: enable for all node types by default.
  $types = node_type_get_types();
  $enabled_bundles = array();
  foreach ($types as $type) {
    $enabled_bundles[$type->type] = 1;
  }

  // Only set enabled_bundles dynamically here. Static defaults (thresholds,
  // weights, checks_enabled, options) are provided via config/install JSON so
  // Backdrop will import them when the module is enabled. This avoids
  // duplicating defaults in code and keeps configuration manageable.
  $config->set('enabled_bundles', $enabled_bundles);
  $config->save();
}

/**
 * Implements hook_requirements().
 */
function openai_seo_advisor_requirements($phase) {
  $requirements = array();

  // Only check on install/update (runtime) phases.
  if ($phase === 'runtime') {
    // The module depends on contrib OpenAI for AI suggestions which are
    // currently mandatory. If the openai module is missing or disabled show a
    // error in the status report and admin pages.
    if (!module_exists('openai')) {
      $requirements['openai_seo_advisor_openai_dependency'] = array(
        'title' => t('OpenAI module dependency'),
        'value' => t('Missing'),
        'severity' => REQUIREMENT_ERROR,
        'description' => t('The OpenAI SEO Advisor module requires the contributed OpenAI module to be installed and enabled because AI suggestions are not optional in this release.'),
      );
    }
    else {
      $requirements['openai_seo_advisor_openai_dependency'] = array(
        'title' => t('OpenAI module dependency'),
        'value' => t('Present'),
        'severity' => REQUIREMENT_OK,
        'description' => t('The OpenAI module is available.'),
      );
    }
  }

  return $requirements;
}
