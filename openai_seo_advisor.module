/**
 * Loader for SEO reports.
 */
function openai_seo_report_load($report_id) {
  $reports = entity_load('openai_seo_report', array($report_id));
  return $reports ? reset($reports) : FALSE;
}

/**
 * Title callback for report type edit form.
 */
function openai_seo_advisor_report_type_title($name) {
  $config = config('openai_seo_advisor.report_type.' . $name);
  return $config->get('label');
}

/**
 * Access callback for node SEO tab.
 */
function openai_seo_advisor_node_reports_access($node) {
  if (!user_access('view openai seo reports') && !user_access('administer openai seo settings')) {
    return FALSE;
  }

  $config = config('openai_seo_advisor.settings');
  $enabled_bundles = $config->get('enabled_bundles');
  if (empty($enabled_bundles) || !is_array($enabled_bundles)) {
    return FALSE;
  }

  return !empty($enabled_bundles[$node->type]);
}




