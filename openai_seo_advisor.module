function openai_seo_advisor_form_alter(&$form, &$form_state, $form_id) {
  // Currently only using analyze form on dedicated SEO tab
}

/**
 * Get all available report types.
 */
function openai_seo_advisor_get_report_types() {
  $types = array();
  $configs = config_get_names_with_prefix('openai_seo_advisor.report_type.');

  foreach ($configs as $config_name) {
    $config = config($config_name);
    $name = str_replace('openai_seo_advisor.report_type.', '', $config_name);
    $types[$name] = array(
      'name' => $name,
      'label' => $config->get('label'),
      'description' => $config->get('description'),
      'prompt' => $config->get('prompt'),
      'status' => $config->get('status'),
      'weight' => $config->get('weight'),
    );
  }

  uasort($types, function($a, $b) {
    if ($a['weight'] == $b['weight']) {
      return strcmp($a['label'], $b['label']);
    }
    return $a['weight'] < $b['weight'] ? -1 : 1;
  });

  return $types;
}

/**
 * Check if a report type exists.
 */
function openai_seo_advisor_report_type_exists($name) {
  $config = config('openai_seo_advisor.report_type.' . $name);
  return !$config->isNew();
}

/**
 * Load reports include file.
 *
 * This ensures that report rendering functions are available when needed.
 */
function openai_seo_advisor_include_reports() {
  static $loaded = FALSE;
  if (!$loaded) {
    module_load_include('inc', 'openai_seo_advisor', 'openai_seo_advisor.reports');
    $loaded = TRUE;
  }
}
