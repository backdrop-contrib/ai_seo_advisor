<?php
/**
 * @file
 * OpenAI SEO Advisor module.
 *
 * Provides a SEO analysis panel on node edit forms. Analysis is driven by
 * config-defined report types (see `config/openai_seo_advisor.report_type.*.json`).
 * Many report types are AI-driven and require the contrib OpenAI module when
 * enabled in settings. The module treats AI output as suggestions only.
 */

/**
 * Implements hook_autoload_info().
 */
function openai_seo_advisor_autoload_info() {
  return array(
    'OpenAISEOReport' => 'includes/openai_seo_report.entity.inc',
    'OpenAISEOReportController' => 'includes/openai_seo_report.entity.inc',
  );
}

/**
 * Implements hook_init().
 */
function openai_seo_advisor_init() {
  $css = '#openai-seo-advisor-results .messages.warning, #openai-seo-advisor-results .messages.messages--warning { display: none !important; }';
  backdrop_add_css($css, array('type' => 'inline'));
}

/**
 * Implements hook_permission().
 */
function openai_seo_advisor_permission() {
  return array(
    'analyze content seo with openai' => array(
      'title' => t('Analyze content SEO with OpenAI'),
      'description' => t('Use the SEO Advisor panel on node forms and run analysis.'),
    ),
    'view openai seo reports' => array(
      'title' => t('View OpenAI SEO reports'),
      'description' => t('View saved SEO analysis reports on content pages.'),
    ),
    'administer openai seo settings' => array(
      'title' => t('Administer OpenAI SEO Advisor settings'),
      'description' => t('Configure the OpenAI SEO Advisor module.'),
    ),
  );
}

/**
 * Implements hook_entity_info().
 */
function openai_seo_advisor_entity_info() {
  $info = array();

  $info['openai_seo_report'] = array(
    'label' => t('SEO Report'),
    'plural label' => t('SEO Reports'),
    'entity class' => 'OpenAISEOReport',
    'controller class' => 'OpenAISEOReportController',
    'base table' => 'openai_seo_report',
    'fieldable' => FALSE,
    'entity keys' => array(
      'id' => 'report_id',
    ),
    'bundles' => array(),
    'view modes' => array(
      'full' => array(
        'label' => t('Full report'),
        'custom settings' => FALSE,
      ),
    ),
    'module' => 'openai_seo_advisor',
    'access callback' => 'openai_seo_advisor_report_access',
  );

  return $info;
}

/**
 * Access callback for SEO reports.
 */
function openai_seo_advisor_report_access($op, $report = NULL, $account = NULL) {
  if (empty($account)) {
    global $user;
    $account = $user;
  }

  if (user_access('administer openai seo settings', $account)) {
    return TRUE;
  }

  if ($op == 'view' && user_access('view openai seo reports', $account)) {
    return TRUE;
  }

  if ($op == 'create' && user_access('analyze content seo with openai', $account)) {
    return TRUE;
  }

  if ($op == 'update' || $op == 'delete') {
    if (user_access('administer openai seo settings', $account)) {
      return TRUE;
    }
  }

  return FALSE;
}

